{
  "name": "voxdoc",
  "version": "0.1.0",
  "private": true,
  "description": "Barrierefreie Dokumentenerkennung für blinde Menschen – PWA für iPhone (iOS Safari, VoiceOver).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "preview:https": "vite preview --mode https",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
